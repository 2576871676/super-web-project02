<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.king.mapper.EmpExprMapper">
    <!--批量保存员工工作经历信息-->
    <insert id="insertBatch">
        insert into emp_expr(emp_id, begin, end, company, job) VALUES
        <foreach collection="exprList" item="expr" separator=",">
            (#{expr.empId},#{expr.begin},#{expr.end},#{expr.company},#{expr.job})
        </foreach>
    </insert>

    <!--根据员工ID删除工作经历信息-->
    <delete id="deleteByEmpId">
        delete from emp_expr where emp_id = #{empId}
    </delete>

    <!--根据员工ID查询工作经历信息-->
    <select id="getByEmpId" resultType="org.king.pojo.EmpExpr">
        select id, emp_id, begin, end, company, job from emp_expr where emp_id = #{empId}
    </select>

</mapper>
